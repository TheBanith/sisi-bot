# ==========================================
# SISI TELEGRAM BOT & 9ROUTER CONFIGURATION
# ==========================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 9Router AI Gateway Configuration
ROUTER_BASE_URL=http://127.0.0.1:20128/v1
ROUTER_API_KEY=sk-9router-bot-master
DEFAULT_MODEL=sisi
NINE_ROUTER_PASSWORD=your_password_here

# Local Proxy Endpoint (Privoxy -> WARP)
PROXY_URL=http://127.0.0.1:40001


# Maximum Conversation Memory Turns (1 turn = 1 user + 1 assistant message)
MAX_HISTORY_TURNS=20

# Google Gemini API Keys (comma-separated for round-robin rotation)
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Groq API Keys (comma-separated for round-robin rotation & Whisper STT)
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2,your_groq_key_3
