[Unit]
Description=9router AI Gateway
After=network.target warp-svc.service privoxy.service
Requires=privoxy.service

[Service]
Type=simple
User=root
WorkingDirectory=/root
EnvironmentFile=/root/.9router.env
ExecStart=/usr/bin/9router --host 0.0.0.0 --port 20128 --no-browser --skip-update --log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
